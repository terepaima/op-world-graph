echo ""
echo "🔍 Running pre-commit checks (lint-staged)..."
echo "--------------------------------------------"

pnpm -s lint:staged
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "❌ Commit blocked."
  echo "   Fix the ESLint errors above, then stage files again and retry."
  echo ""
  exit $status
fi

echo "✅ Pre-commit checks passed."
echo ""